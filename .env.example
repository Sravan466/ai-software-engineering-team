# ──────────────────────────────────────────────────────────────────────────
# AI Software Engineering Team — environment configuration
# Copy to .env. All defaults work fully offline with Ollama (no API keys).
# ──────────────────────────────────────────────────────────────────────────

# ── App ──
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated origins allowed by CORS (the Next.js dev server by default)
CORS_ORIGINS=http://localhost:3000

# ── Database ──
# SQLite by default (no setup). For Postgres:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/aiteam
DATABASE_URL=sqlite:///./data/aiteam.db

# ── Model routing ──
# Selection mode used when a project does not specify one: auto | manual | local_only
DEFAULT_ROUTING_MODE=local_only
# Default local model (must be pulled: `ollama pull qwen2.5:7b`)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:7b
# Fallback chain (comma-separated provider:model). Tried left to right.
# Local model is last so the pipeline keeps running even with no API keys.
FALLBACK_CHAIN=ollama:qwen2.5:7b

# ── Context window & prompt budgets ──
# The local window is PROBED from the model itself (POST /api/show) and clamped by
# how much KV cache your RAM holds. Nothing here is a window this app assumes — they
# are ceilings and last resorts.
# Cap the local context window. Leave it commented out and only the model's own
# limit and your RAM decide.
# OLLAMA_CONTEXT_CEILING=8192
# Share of physical RAM the KV cache may claim once the weights are loaded.
OLLAMA_RAM_FRACTION=0.6
# Window assumed ONLY when a provider will not report one at all.
MODEL_CONTEXT_FALLBACK_TOKENS=8192
# Ceiling on tokens one call may generate (the resolved window can lower it).
MAX_OUTPUT_TOKENS=4096
# Characters per token, used to turn a token budget into a truncation length.
# 3.0 is deliberate: indented JSON and source code tokenize denser than prose, and
# a value above ~3.2 budgets prompts that overrun the window they were sized for.
APPROX_CHARS_PER_TOKEN=3.0
# Ceiling on tokens one prompt may occupy, whatever the window allows. Guards against
# a large cloud window inlining every earlier phase in full into every later one.
MAX_PROMPT_TOKENS=24576
# Warn in Settings when the pulled model is smaller than this.
SMALL_MODEL_PARAMETER_COUNT=4000000000
# How many times a schema-invalid agent response is sent back for repair.
SCHEMA_REPAIR_ROUNDS=1

# ── Cloud providers (optional) ──
# Leave blank to stay fully local. Presence of a key enables that provider in Auto mode.
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-opus-4-8
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-1.5-pro
# Published context windows — cloud providers expose no probe to ask.
ANTHROPIC_CONTEXT_TOKENS=200000
OPENAI_CONTEXT_TOKENS=128000
GEMINI_CONTEXT_TOKENS=1000000

# ── GitHub publishing (optional — "Push to GitHub" button) ──
# Lets any user click "Connect GitHub", log in as themselves, and push the
# generated project into a new repo on THEIR account. 100% free.
# Setup (~2 min): https://github.com/settings/developers → New OAuth App
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:8000/api/github/oauth/callback
# Then paste the Client ID + a generated Client Secret below. Leave blank to
# hide the button (the rest of the app works fine without it).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# "repo" allows creating private repos; "public_repo" restricts to public only.
GITHUB_SCOPE=repo
# Public URLs used to build the OAuth redirect + post-login return.
BACKEND_PUBLIC_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000

# ── Vector store (memory + RAG) ──
CHROMA_PERSIST_DIR=./data/chroma
# Embedding model served by Ollama for local embeddings (pull: `ollama pull nomic-embed-text`)
EMBEDDING_MODEL=nomic-embed-text

# ── Pipeline behaviour ──
# Require human approval after each phase before advancing.
REQUIRE_APPROVAL=true
# Enable the agent debate step between System Design and Backend.
ENABLE_DEBATE=true
